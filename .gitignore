.DS_Store
.env
.env.*
!.env.example
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Provider material is local unless explicitly reduced to safe readiness metadata.
.provider-cache/
provider-responses/
*.provider-response.json

# Ad-hoc outputs stay local; registered IE3 dev/test evidence and reduced references are kept.
experiments/*
!experiments/.gitkeep
!experiments/ie3-dev/
!experiments/ie3-dev/**
!experiments/ie3-test/
!experiments/ie3-test/**
!experiments/ie3-openai-recovery/
!experiments/ie3-openai-recovery/**
!experiments/reference/
experiments/reference/*
!experiments/reference/kir-pilot-v2-ie2-final/
!experiments/reference/kir-pilot-v2-ie2-final/**

# Human-review workbooks are versioned; rendered previews and inspection dumps are local QA.
outputs/**/previews/
outputs/**/*.inspect.ndjson
~$*.xls*
